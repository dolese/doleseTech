# ─────────────────────────────────────────────────────────────
# Dolese Tech — environment configuration
# Copy this file to `.env.local` and fill in what you need.
# Everything here is OPTIONAL — the app boots and the contact
# form works (leads are written to ./data/leads.jsonl) with no
# config at all.
# ─────────────────────────────────────────────────────────────

# ── Email notifications (Resend) ──────────────────────────────
# When set, new contact submissions are emailed to CONTACT_TO.
# Get a key at https://resend.com — leave blank to disable email.
RESEND_API_KEY=
# Verified sender (must be a domain/address verified in Resend).
CONTACT_FROM="Dolese Tech <hello@dolese.tech>"
# Where lead notifications are delivered.
CONTACT_TO=support@dolese.tech

# NOTE: on a host with a read-only filesystem (Vercel), email is the ONLY
# way an enquiry reaches you — file storage below cannot be written there.
# Without RESEND_API_KEY the contact form tells visitors to email or
# WhatsApp instead. Check /api/health: contactFormWorking must be true.

# ── Site address (canonical URLs, sitemap, social previews) ───
# Defaults to https://dolese.tech when unset.
SITE_URL=

# ── Lead storage ──────────────────────────────────────────────
# Postgres (Neon) connection string. When set, leads and their status/notes
# live here and the admin inbox works on any host. Strongly recommended in
# production: without it, a read-only host keeps no copy of an enquiry beyond
# the notification email. The table is created on first use.
DATABASE_URL=

# File fallback, used when DATABASE_URL is empty (local development).
# Absolute or relative path for the file-based lead log.
# Defaults to ./data/leads.jsonl when unset.
LEADS_FILE=

# ── Admin dashboard (/admin) ──────────────────────────────────
# Password for signing in. Exchanged for a signed, httpOnly session
# cookie; the password itself is not stored in the browser. Leave blank
# to disable the admin routes (they return 503).
ADMIN_PASSWORD=

# Optional. Signs the session cookie. Rotating it signs everyone out
# without changing the password. Falls back to ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Optional. The ResultsPortal API the admin Systems view probes.
# Defaults to the Railway deployment.
RESULTS_PORTAL_API=

# ── AI spend limits (optional) ────────────────────────────────
# Budgets are in "units": one Haiku or Gemini Flash call = 1, Sonnet = 3,
# Gemini Pro = 6, Opus = 10. Counted in the database when one is configured,
# so they hold across every serverless instance.
# Per visitor, per hour, for the chat assistant (default 60):
AI_CHAT_HOURLY_UNITS=
# Per visitor, per hour, for the Exams Composer (default 30; a full paper
# counts as two calls, since it may run a repair pass):
AI_EXAMS_HOURLY_UNITS=
# Whole site, per day, across all visitors — the hard ceiling on AI spend
# (default 1500). When reached, AI features pause until the next day.
AI_DAILY_UNITS=

# ── AI assistant (/chat) & Exams Composer ─────────────────────
# Anthropic API key — powers the Claude models (Haiku 4.5, Sonnet 4.6,
# Opus 4.8). Get one at https://console.anthropic.com. Leave blank to
# disable Claude models (those requests return 503).
# Put the REAL key in .env.local (gitignored), never in this example file.
ANTHROPIC_API_KEY=

# Google Gemini API key — powers the Gemini models (2.5 Flash / 2.5 Pro).
# Get one at https://aistudio.google.com/apikey. Leave blank to disable
# Gemini (those requests return 503).
# Put the REAL key in .env.local (gitignored), never in this example file.
GEMINI_API_KEY=